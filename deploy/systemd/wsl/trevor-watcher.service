# /etc/systemd/system/trevor-watcher.service — RF2-C1
# The R10 watcher oversight loop (surface + review + integrity, A2 shape #5, driven by
# watcher_health.run_cycle — the ONLY module with a real daemon __main__). review/integrity
# get NO unit of their own; they run in-process inside this one loop.
#
# 🚨 LIVE — header corrected [B8] 2026-08-18 on TrevorHub (the WSL distro, ghost@Ghost).
#    This block used to read "INSTALL-ONLY today: NOT `enable`d, NOT `--now`" — it asserted the
#    OPPOSITE of this unit's own live state. MEASURED on 2026-08-18:
#      UnitFileState=enabled · ActiveState=active (running) since 2026-08-12 09:35:06 EDT · NRestarts=0
#      (`systemctl show trevor-watcher.service -p UnitFileState -p ActiveState -p ActiveEnterTimestamp -p NRestarts`)
#
# 🚨 The old header's MECHANISM was void too, not just its state. It argued the unit was inert
#    because "all WATCHER_* flags default OFF", so watcher_health.py's main() returns 0 at once
#    and Type=simple would drop it to `inactive (dead)`. All three flags are `true` in the
#    EnvironmentFile below (WATCHER_SURFACING_ENABLED, WATCHER_REVIEW_ENABLED,
#    WATCHER_INTEGRITY_ENABLED), so this IS a live daemon — not a briefly-running no-op. The R13
#    go-live step the old text described as still pending HAS ALREADY HAPPENED.
#
# 🚨 This correction is TEXT ONLY: no directive changed, and nothing was enabled, disabled,
#    started or stopped to make the words true. 🚨 The identical false header also lived in the
#    TRACKED repo copy at deploy/systemd/wsl/trevor-watcher.service and was corrected in the SAME
#    commit — fixing only the installed unit would let the next deploy re-infect it.
[Unit]
Description=TREVOR Watcher (oversight loop) — RF-2
After=network-online.target tailscaled.service
Wants=network-online.target
# WSL-local death alert: on a SUSTAINED crash (Restart budget exhausted -> `failed`) systemd
# starts trevor-alert@trevor-watcher.service, which POSTs to Discord (#qa-agent once minted,
# else #downloads). A single crash-and-recover never reaches `failed` -> fires nothing.
OnFailure=trevor-alert@%n.service
# Defines "sustained failure": 5 failed starts within 300s -> `failed` -> OnFailure fires.
# At RestartSec=3 that's ~15s of instant crashes; a lone crash-and-recover never trips it.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ghost
WorkingDirectory=/home/ghost/projects/trevor-dashboard
# 🚨 EnvironmentFile is how the WATCHER_* flags AND ANTHROPIC_API_KEY reach the process.
#    Omitting it = the daemon starts with no flags/key: inert + silently under-powered.
EnvironmentFile=/home/ghost/projects/trevor-dashboard/.env.local
# HOME for run_watcher_loop's heartbeat.pre_register() ssh-pipe write to the VM loop_heartbeat.
# 🚨 RF3T2-B8 CORRECTION: the old comment here claimed "Without it the heartbeat silently
#    degrades" — that is FALSE and it is what generated the T2-h roadmap item. ssh resolves the
#    `vm` alias + key from the UID via getpwuid, NOT $HOME (measured: foreign/empty/unset HOME
#    and `env -i` all authenticate; as root WITH HOME=/home/ghost it FAILS). `User=ghost` is what
#    makes it resolve. This line is DEFENSIVE ONLY — harmless, and other tools do read $HOME.
#    The silent-degradation CONCLUSION was right; the MECHANISM was wrong.
Environment=HOME=/home/ghost
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 watcher_health.py
# on-failure (NOT always): flag-OFF main() exits 0 (success) -> no restart-loop of the inert no-op.
Restart=on-failure
RestartSec=3
# 🚨 NO WatchdogSec. A bare one < the 900s inter-cycle sleep would SIGABRT a HEALTHY loop every
#    cycle, and a hang->kill->restart->hang loop never reaches `failed` so it would never alert
#    (the wedge row stays documented-open — heartbeat staleness is the eventual signal).

[Install]
WantedBy=multi-user.target
