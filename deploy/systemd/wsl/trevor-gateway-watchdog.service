# ─────────────────────────────────────────────────────────────────────────────
# TREVOR Hub — gateway health watchdog (WSL TrevorHub box)  [INSTALLED, ENABLED, ACTIVE]
#
# STATUS: INSTALLED at /etc/systemd/system/, enabled, and active running. Verified
# live 2026-07-25 (RD-C4).
#
# 🚨 THIS HEADER USED TO READ "[AUTHORED, NOT INSTALLED]" and "DELIBERATELY NOT
# installed/enabled yet — goes live at the Wave D cutover", while the unit was
# installed, enabled and running. RD-B6 recorded the true state in this unit's
# drop-in but did not correct the header, so the file kept asserting the opposite of
# its own live state. A header that contradicts `systemctl is-active` is worse than
# no header: it is the first thing a reader trusts and the last thing anyone checks.
# If you change this unit's installed state, change this line in the same commit.
#
# Rollback (returns to the pre-install state this header used to describe):
#   sudo systemctl disable --now trevor-gateway-watchdog
#   sudo rm /etc/systemd/system/trevor-gateway-watchdog.service && sudo systemctl daemon-reload
#
# WHY: trevor-gateway.service has Restart=on-failure (restarts only on process EXIT).
# A wedged-but-alive gateway (event loop hung, still bound to :3939, never exits)
# would never restart. This polls the UNAUTHENTICATED GET /healthz liveness probe
# (200 {"status":"ok"}) and self-heals a hang — the gateway-side mirror of the VM's
# trevor-dashboard-watchdog.service.
#
# MECHANISM: reuses deploy/scripts/dashboard_health_watchdog.sh UNCHANGED, fully
# parameterized via Environment= below (HEALTH_URL / WATCHDOG_SERVICE /
# WATCHDOG_STATE_DIR / ENV_FILE). No script fork.
#   • ENV_FILE → the Hub's .env.local so restart/recovery/give-up notices post to
#     #qa-agent (DISCORD_BOT_TOKEN read-only, same idiom as the VM watchdog).
#   • WATCHDOG_STATE_DIR is gateway-specific so its restart history / give-up window
#     never collide with any dashboard watchdog's state.
# ─────────────────────────────────────────────────────────────────────────────
[Unit]
Description=TREVOR Hub gateway health watchdog — auto-restart trevor-gateway on a /healthz wedge (WSL)
Documentation=https://github.com/ipost76/trevor-dashboard
# Watch the gateway; don't fail if it's briefly down.
After=trevor-gateway.service
Wants=trevor-gateway.service

[Service]
Type=simple
User=ghost
# Reuse the dashboard watchdog script verbatim, retargeted to the gateway via env.
Environment=HEALTH_URL=http://127.0.0.1:3939/healthz
Environment=WATCHDOG_SERVICE=trevor-gateway.service
Environment=WATCHDOG_STATE_DIR=/home/ghost/.local/state/trevor-gateway-watchdog
Environment=ENV_FILE=/home/ghost/projects/trevor-dashboard/.env.local
ExecStart=/home/ghost/projects/trevor-dashboard/deploy/scripts/dashboard_health_watchdog.sh
Restart=always
RestartSec=10
# It's just curl + sleep — keep it tiny.
MemoryMax=64M
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
