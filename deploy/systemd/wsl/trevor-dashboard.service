[Unit]
Description=TREVOR Hub Dashboard (read path, :3000) — RM-WSL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghost
WorkingDirectory=/home/ghost/projects/trevor-dashboard
EnvironmentFile=/home/ghost/projects/trevor-dashboard/.env.local
# npm start === node server.js; node directly gives systemd a clean MainPID.
# PORT=3000 is supplied by the EnvironmentFile (.env.local).
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
