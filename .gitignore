node_modules/
.next/
# B4-HUB-RESILIENCE: scripts/build_atomic.sh staging + rollback dirs. Same content
# class as .next/ (~260MB each) — untracked and never staged.
.next.build/
.next.prev/
data/
*.log
__pycache__/
*.pyc
*.backup*
# Secrets — never commit. Held on disk at 600 perms; loaded by server.js + /api/auth.
.env
.env.*
.env.local
.env.*.bak*
.env.bak*
# Local SQLite copies that should never be pushed
trevor.db
trevor.db-wal
trevor.db-shm
# tsconfig build cache (drifts on every build)
tsconfig.tsbuildinfo

# WSL hub runtime (B-P1 read-path migration)
venv/

# Per-file lock + commit-serialization guard runtime (LOCK-WSL) — never commit live locks
.locks/

# W-C-P2-DELIVERY: downloads runtime tree — commit the scaffolding (.gitkeep),
# ignore runtime data (delivered files + the manifest/categories the pipeline
# mutates on every post). download_manager recreates empty ones on demand.
downloads/active/*
downloads/archive/*
!downloads/active/.gitkeep
!downloads/archive/.gitkeep
downloads/manifest.json
downloads/categories.json
downloads/*.tmp
